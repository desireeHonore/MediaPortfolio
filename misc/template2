<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>✨ CuteSpark Portfolio ✨</title>

  <!-- Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Fascinate&family=VT323&family=Space+Mono&display=swap" rel="stylesheet">

  <!-- Styles -->
  <style>
    :root {
      --main-bg: #1a1a1a;
      --accent-1: #008B8B;
      --accent-2: #D8BFD8;
      --text-light: #f7f7f7;
      --container-width: 700px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'VT323', monospace;
      background-color: var(--main-bg);
      color: var(--text-light);
      padding: 2rem;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .container {
      max-width: var(--container-width);
      width: 100%;
    }

    header {
      margin-bottom: 2rem;
      position: relative;
      text-align: center;
    }

    .sparkle-title {
      font-family: 'Fascinate', cursive;
      font-size: 3rem;
      color: var(--accent-2);
      position: relative;
      display: inline-block;
      cursor: pointer;
    }

    .sparkle-title:hover::after {
      content: '✨';
      position: absolute;
      right: -30px;
      top: 0;
      animation: sparkle 0.8s infinite;
    }

    @keyframes sparkle {
      0% { opacity: 0; transform: scale(0.5) rotate(0deg);}
      50% { opacity: 1; transform: scale(1.5) rotate(45deg);}
      100% { opacity: 0; transform: scale(0.5) rotate(90deg);}
    }

    nav {
      position: fixed;
      top: 20px;
      left: 20px;
      z-index: 100;
    }

    .menu-toggle {
      background-color: transparent;
      border: 2px solid var(--accent-2);
      color: var(--accent-2);
      font-size: 1.2rem;
      padding: 0.5rem 1rem;
      cursor: pointer;
      transition: all 0.3s ease;
      font-family: 'Space Mono', monospace;
    }

    .menu-toggle:hover {
      background-color: var(--accent-2);
      color: var(--main-bg);
    }

    .menu {
      position: fixed;
      top: 60px;
      left: 20px;
      background-color: #2a2a2a;
      padding: 1rem;
      border-radius: 8px;
      display: none;
      box-shadow: 0 0 10px rgba(0,0,0,0.5);
    }

    .menu a {
      display: block;
      margin: 0.5rem 0;
      text-decoration: none;
      color: var(--accent-1);
      font-family: 'Space Mono', monospace;
      transition: all 0.2s ease;
    }

    .menu a:hover {
      color: var(--accent-2);
      transform: translateX(5px);
    }

    .section {
      margin-bottom: 3rem;
      text-align: center;
    }

    h2 {
      font-family: 'Space Mono', monospace;
      color: var(--accent-1);
      font-size: 2rem;
      margin-bottom: 1rem;
    }

    .portrait {
      width: 300px;
      height: auto;
      border-radius: 16px;
      border: 4px solid var(--accent-2);
      transition: transform 0.4s ease, box-shadow 0.4s ease;
    }

    .portrait:hover {
      transform: rotate(-2deg) scale(1.05);
      box-shadow: 0 0 20px var(--accent-1);
    }

    footer {
      text-align: center;
      font-size: 1rem;
      margin-top: 2rem;
      color: var(--accent-2);
    }
  </style>

  <!-- Script -->
  <script>
    function toggleMenu() {
      const menu = document.getElementById('menu');
      menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
    }
  </script>
</head>

<body>
  <nav>
    <button class="menu-toggle" onclick="toggleMenu()">☰ Homework</button>
    <div class="menu" id="menu">
      <a href="readings.html">Readings</a>
      <a href="hw1.html">Homework 1</a>
      <a href="hw2.html">Homework 2</a>
      <a href="hw3.html">Homework 3</a>
      <a href="hw4.html">Homework 4</a>
    </div>
  </nav>

  <div class="container">
    <header>
      <div class="sparkle-title">✨ My Portfolio ✨</div>
    </header>

    <section class="section">
      <h2>About Me</h2>
      <img src="portrait1.png" alt="My Portrait" class="portrait" />
      <p style="margin-top:1rem;">Hey there! I'm a creative technologist who loves coding, design, and sparkles. This site is my digital playground — a space for learning, experimenting, and building something beautiful.</p>
    </section>

    <footer>
      <p>&copy; 2025 — Handmade with 💻 & ✨</p>
    </footer>
  </div>
</body>
</html>



